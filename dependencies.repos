# Upstream vendor packages required to build this workspace.
#
# These are NOT committed into this repository (see .gitignore: `src/agx_*`);
# they are fetched at a pinned commit so the build is reproducible.
#
#   vcs import src < dependencies.repos
#
# Prefer `scripts/setup_deps.sh`, which additionally resolves the nested
# agx_arm_urdf submodule to the commit this workspace was validated against.

repositories:
  agx_arm_ros:
    type: git
    url: https://github.com/agilexrobotics/agx_arm_ros.git
    # branch: ros2
    version: b03e16afc5d47ad6a2dd487e6614c836bfe005ec
